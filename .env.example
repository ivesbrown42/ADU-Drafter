# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit your real API key.

# Required: Your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: swap to a different model (default: gpt-4o)
# LLM_MODEL=gpt-4o-mini

# Optional: use an OpenAI-compatible endpoint
# Ollama (local, no key needed — set OPENAI_API_KEY=ollama):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
#
# Anthropic (via openai-compat proxy):
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-3-5-sonnet-20241022
#
# Google Gemini (OpenAI-compat):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# Optional: sampling temperature (default: 0.7)
# LLM_TEMPERATURE=0.7

# Optional: max response tokens (default: 4096)
# LLM_MAX_TOKENS=4096
